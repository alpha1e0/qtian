/**
 * Electron Builder Configuration
 */
{
  extraResources: [
    {
      from: 'backend/data',
      to: 'data',
    },
    {
      from: 'public/tray.png',
      to: 'tray.png',
    }
  ],
  win: {
    target: ['nsis'],
    artifactName: '${productName}-${version}-setup.${ext}'
  },
  mac: {
    target: ['dmg'],
    artifactName: '${productName}-${version}.${ext}'
  },
  linux: {
    target: ['AppImage'],
    artifactName: '${productName}-${version}.${ext}'
  },
  files: [
    'dist-electron/**/*',
    'package.json'
  ],
  // napi 原生二进制（@node-rs/jieba 等）必须解包到 asar 外，否则无法加载 .node 文件
  asarUnpack: [
    '**/*.node',
    '**/@node-rs/**'
  ]
}
